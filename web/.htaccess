# Box of Dragons — stripped PHP version
# Route all non-file requests to index.php

RewriteEngine On
RewriteBase /

# Don't route real files or directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route everything else to the front controller
RewriteRule ^ index.php [L]
