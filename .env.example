# Box of Dragons — environment variables
#
# Copy this file to .env and fill in the values.
# On the VPS, .env is read by lib/db.php (for the site) and web/webhook.php
# (for the GitHub webhook signature verification).

# Database connection (DDEV local dev defaults shown)
DB_HOST=db
DB_PORT=3306
DB_NAME=db
DB_USER=db
DB_PASSWORD=db

# Site
SITE_NAME=Box of Dragons
SITE_URL=https://www.boxofdragons.misssponto.me.uk

# GitHub Webhook Secret
# Used by web/webhook.php to verify GitHub push event signatures.
# Set this to the same value configured in GitHub repo settings -> Webhooks.
GITHUB_WEBHOOK_SECRET=""
