{% extends '_layouts/base.twig' %}

{% block pageTitle %}
    Log In - {{ parent() }}
{% endblock %}

{% block pageDescription %}
    Sign in to your account or create a new one.
{% endblock %}

{% block pageSubheader %}
    {% include '_partials/page-subheader.twig' with { pageName: 'Log In' } %}
{% endblock %}

{% block pageContent %}
<main class="shell">
    <section aria-label="Authentication">
        <div id="auth-authenticated" class="panel panel--padded" hidden>
            <p class="subtitle">You are logged in as <span id="auth-user-email"></span>.</p>
            <p>
                <button class="button button-secondary" id="auth-sign-out" type="button">Sign out</button>
            </p>
        </div>

        <div id="auth-anonymous">
            <div class="panel panel--padded">
                <h2>Sign in</h2>
                <form id="sign-in-form">
                    <p class="form-row">
                        <label for="sign-in-email">Email</label>
                        <input id="sign-in-email" type="email" name="email" required autocomplete="email">
                    </p>
                    <p class="form-row">
                        <label for="sign-in-password">Password</label>
                        <input id="sign-in-password" type="password" name="password" required autocomplete="current-password">
                    </p>
                    <p class="checkbox-row">
                        <input id="sign-in-remember" type="checkbox" name="rememberMe" checked>
                        <label for="sign-in-remember">Keep me signed in</label>
                    </p>
                    <p>
                        <button class="button button-primary" type="submit">Sign in</button>
                    </p>
                    <p class="caption" id="sign-in-message" role="status"></p>
                </form>
            </div>

            <div class="panel panel--padded">
                <h2>Create account</h2>
                <form id="sign-up-form">
                    <p class="form-row">
                        <label for="sign-up-name">Name</label>
                        <input id="sign-up-name" type="text" name="name" autocomplete="name">
                    </p>
                    <p class="form-row">
                        <label for="sign-up-email">Email</label>
                        <input id="sign-up-email" type="email" name="email" required autocomplete="email">
                    </p>
                    <p class="form-row">
                        <label for="sign-up-password">Password</label>
                        <input id="sign-up-password" type="password" name="password" required autocomplete="new-password">
                    </p>
                    <p>
                        <button class="button button-primary" type="submit">Create account</button>
                    </p>
                    <p class="caption" id="sign-up-message" role="status"></p>
                </form>
            </div>
        </div>
    </section>
</main>
{% endblock %}

{% block scripts %}
<script>
(function () {
    const authBase = '/api/auth';

    async function api(method, path, body) {
        const options = { method: method, credentials: 'include', headers: {} };
        if (body !== undefined) {
            options.headers['Content-Type'] = 'application/json';
            options.body = JSON.stringify(body);
        }
        const response = await fetch(authBase + path, options);
        const data = response.headers.get('content-type') && response.headers.get('content-type').indexOf('application/json') !== -1
            ? await response.json()
            : null;
        if (!response.ok) {
            const err = new Error(data && data.message ? data.message : response.statusText);
            err.code = data && data.code ? data.code : '';
            err.status = response.status;
            throw err;
        }
        return data;
    }

    async function updateSession() {
        const anonymousEl = document.getElementById('auth-anonymous');
        const authenticatedEl = document.getElementById('auth-authenticated');
        const userEmailEl = document.getElementById('auth-user-email');

        const data = await api('GET', '/get-session');
        if (data && data.user) {
            anonymousEl.hidden = true;
            authenticatedEl.hidden = false;
            userEmailEl.textContent = data.user.email || data.user.name || 'you';
        } else {
            anonymousEl.hidden = false;
            authenticatedEl.hidden = true;
        }
    }

    function handleForm(formId, messageId, path, buildBody) {
        const form = document.getElementById(formId);
        const message = document.getElementById(messageId);

        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            message.textContent = '';

            try {
                const body = buildBody(new FormData(form));
                await api('POST', path, body);
                message.textContent = 'Success.';
                await updateSession();
            } catch (err) {
                message.textContent = err.message || 'Something went wrong.';
            }
        });
    }

    handleForm('sign-in-form', 'sign-in-message', '/sign-in/email', function (fd) {
        return {
            email: fd.get('email'),
            password: fd.get('password'),
            rememberMe: fd.get('rememberMe') === 'on'
        };
    });

    handleForm('sign-up-form', 'sign-up-message', '/sign-up/email', function (fd) {
        const body = {
            email: fd.get('email'),
            password: fd.get('password')
        };
        const name = fd.get('name');
        if (name) {
            body.name = name;
        }
        return body;
    });

    document.getElementById('auth-sign-out').addEventListener('click', async function () {
        await api('POST', '/sign-out');
        await updateSession();
    });

    updateSession();
})();
</script>
{% endblock %}
